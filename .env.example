# Jev SEO Radar — настройки.
# Копирай този файл като .env и попълни ключовете:  cp .env.example .env
# .env не се качва в git. Ключовете живеят само тук: интерфейсът никога не ги вижда, не ги записва и не ги връща.
# След всяка промяна рестартирай сървъра, за да прочете файла. Проверка на ключовете: npm run doctor

# ── Jev (TypeSafe AI) — задължително за истински анализ ──────────────────────────────
JEV_API_KEY=
# Ключ от Vercel AI Gateway (започва с vck_) се разпознава автоматично и ползва шлюза им.
# Само ако ползваш друг адрес (прокси, тестова среда). Трябва да е https://
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# Цена на милион входни токена в USD (по документацията на TypeSafe: 0.042; изходните токени са безплатни).
# Служи само за ориентировъчната сума в отчета.
# JEV_PRICE_PER_MTOK=0.042

# ── Резултати от Google (SERP) — достатъчен е един доставчик ───────────────────────
# Jev не знае кой е на първа страница днес. Това идва от доставчик на SERP данни.
SERPER_API_KEY=
# или DataForSEO (дава и месечни търсения за фразите):
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# Принуди доставчик: serper | dataforseo | none (none = само ръчен режим с адреси на конкуренти)
# SERP_PROVIDER=
# none изключва месечните търсения, дори да има DataForSEO данни
# VOLUME_PROVIDER=

# ── ИИ двигатели: ChatGPT, Claude, Gemini (по избор; всеки е самостоятелен) ──────────────
# Одитът „Мой сайт“ ги пита въпросите на купувачите, с търсене в мрежата, и проверява дали сайтът ти е цитиран.
# Без нито един ключ одитът работи, но не проверява ИИ. Най-малко един ключ е нужен и за езиков модел, който пише
# предложения за заглавия и чеклисти (иначе се ползват фиксирани правила).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Кой двигател пише предложенията: anthropic | openai | gemini | none (по подразбиране: първият с ключ, по този ред)
# WRITER_ENGINE=anthropic
# Горни граници за един одит (защита от случайно висока сметка)
# MAX_AUDIT_PAGES=100
# MAX_GEO_QUESTIONS=60
# MAX_GEO_CALLS_PER_RUN=150
# Проверка на ключовете: npm run doctor -- --engines

# ── Достъп ──────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
# Парола за интерфейса (HTTP Basic; потребителското име е без значение).
# Задължителна, ако HOST не е локален — иначе сървърът отказва да стартира. Поне 12 знака, когато HOST не е локален.
APP_PASSWORD=
# Само ако пред приложението има друга защита (reverse proxy с вход):
# ALLOW_PUBLIC_WITHOUT_PASSWORD=1
# Без парола сървърът отговаря само на localhost и 127.0.0.1 (защита от DNS rebinding). Ако го отваряш през друго име
# (например reverse proxy), изброй имената тук, разделени със запетая, без порт:
# ALLOWED_HOSTS=radar.local

# ── Данни, лимити, обхождане ─────────────────────────────────────────────────────
DATA_DIR=./data
# Колко часа се пазят кешираните SERP резултати и страници (0 = без кеш)
CACHE_TTL_HOURS=24
# Горни граници за един анализ — защита от случайно висока сметка
MAX_SERP_CALLS_PER_RUN=45
MAX_PAGES_PER_RUN=16
MAX_CANDIDATES=40
# Колко отчета се пазят. При достигане нови анализи се отказват, докато не изтриеш стари.
MAX_REPORTS=500
MAX_CONCURRENT_JOBS=2
CRAWL_TIMEOUT_MS=12000
CRAWL_MAX_BYTES=2000000
# Как се представя обхождането пред сайтовете на конкурентите (спазва се и robots.txt)
# CRAWLER_USER_AGENT=JevSeoRadar/0.1 (+https://github.com/pavlovdevelop/jev-system-seo)

# ── Демо ────────────────────────────────────────────────────────────────────────
# Примерни данни без външни заявки и без ключове. Същото прави: npm run demo
# DEMO_MODE=1
